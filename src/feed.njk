---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <title>{{ site.name }}</title>
  <subtitle>{{ site.tagline }}</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self"/>
  <link href="{{ site.url }}/"/>
  <updated>{{ (collections.resources[0].date if collections.resources.length else '' | currentYear) | isoDate }}</updated>
  <id>{{ site.url }}/</id>
  <author><name>{{ site.name }}</name></author>
  {%- for r in collections.resources | limit(30) %}
  <entry>
    <title>{{ r.data.title | escape }}</title>
    <link href="{{ site.url }}{{ r.url }}"/>
    <id>{{ site.url }}{{ r.url }}</id>
    <updated>{{ (r.data.updated or r.date) | isoDate }}</updated>
    <published>{{ r.date | isoDate }}</published>
    <category term="{{ r.data.type | typeLabel }}"/>
    <summary>{{ r.data.summary | escape }}</summary>
  </entry>
  {%- endfor %}
</feed>
